# Keep this file ASCII-only: python-dotenv decodes it with the Windows locale codepage (gbk)
# and fails on non-ASCII bytes (UnicodeDecodeError).

# ---- LLM provider ----
# google | openai (any OpenAI-compatible endpoint: official / Ollama / vLLM / DeepSeek ...)
LLM_PROVIDER=openai

# Used by the openai branch; local endpoints usually accept any key value
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_API_KEY=

# Model names. Precedence per node: request config (frontend dropdown) > env > code default.
# MODEL is the fallback used when the caller does not choose one.
MODEL=qwen3.8-flash-next-iq2_xs
QUERY_GENERATOR_MODEL=qwen3.8-flash-next-iq2_xs
REFLECTION_MODEL=qwen3.8-flash-next-iq2_xs
ANSWER_MODEL=qwen3.8-flash-next-iq2_xs

# Optional: mixed dropdown across providers, name=provider pairs (falls back to LLM_PROVIDER)
# MODEL_PROVIDER_MAP=gemini-2.5-pro=google,qwen3.8-flash-next-iq2_xs=openai

# Print the provider/model each node actually resolved (useful when the dropdown looks ignored)
LLM_DEBUG=1

# with_structured_output method: empty = langchain default; use json_mode for endpoints
# that ignore tool-calling
STRUCTURED_METHOD=

# ---- Search provider (replaces Gemini-only google_search grounding) ----
# duckduckgo | tavily | searxng | bing | serper | brave | none
# Measured 2026-11-10 with proxy http://127.0.0.1:10808 (git and requests do NOT read the Windows
# system proxy, so it must be given explicitly): duckduckgo 3 results (intermittent "No results found",
# retries fix it most times), bing 3 results, searx.be 200 but returns an antibot HTML page and has
# format=json disabled, brave API reachable (422 without key) while its HTML endpoint returns 429,
# serper/tavily need keys.
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=5
SEARCH_PROXY=http://127.0.0.1:10808
SEARCH_RETRIES=3
SEARCH_FALLBACK=bing
# TAVILY_API_KEY=
# SERPER_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8080    # self-hosted instance; public ones usually disable format=json

# ---- Only needed when LLM_PROVIDER=google ----
# GEMINI_API_KEY=
