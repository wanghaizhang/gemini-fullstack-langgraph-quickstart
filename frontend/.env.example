# Frontend env (Vite only exposes VITE_* to the browser). ASCII only.
# Model dropdown: names must be served by the backend endpoint.
# Format: name|label, comma separated. Empty = the three Gemini defaults in src/lib/modelOptions.ts
VITE_MODEL_OPTIONS=qwen3.8-flash-next-iq2_xs|Qwen 3.8 Flash,deepseek-chat|DeepSeek
# Default selection when the page loads (must be one of the names above)
VITE_DEFAULT_MODEL=qwen3.8-flash-next-iq2_xs
